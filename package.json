{
  "name": "fabrica-flow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.js",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file=.env server/index.js",
    "db:migrate": "node --env-file=.env server/migrate.js",
    "db:seed": "node --env-file=.env server/seed.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "demo": "npm run build && node server/demo.js",
    "build:public": "tsc --noEmit && vite build --mode public && node scripts/finalize-public.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vite": "^6.1.0"
  }
}
